    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.7.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.7.0",
    "happy-dom": "^18.0.0"
  },
  "keywords": [
    "noy-db",
    "auth",
    "oidc",
    "oauth",
    "line",
    "google",
    "apple",
    "keycloak",
