{
  "name": "@noy-db/on-shamir",
  "version": "0.7.1-pre.0",
  "description": "k-of-n Shamir Secret Sharing of the vault KEK for multi-party unlock. Any K of N shares recombines the key; fewer than K leaks zero bits. Composable — each share can be protected by any other on-* method. Math and share codecs live in @noy-db/shamir and are re-exported here.",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/vLannaAi/noy-db-on/tree/main/on-shamir#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vLannaAi/noy-db-on.git",
    "directory": "on-shamir"
  },
  "bugs": {
    "url": "https://github.com/vLannaAi/noy-db/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noy-db/shamir": "^0.7.1-pre.0"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.7.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.7.0"
  },
  "keywords": [
    "noy-db",
    "auth",
    "on-shamir",
    "shamir",
    "secret-sharing",
    "k-of-n",
    "threshold",
    "multi-party",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
